{
  "name": "gom-web-scripts",
  "version": "0.0.0",
  "private": true,
  "description": "The TypeScript of the Gom pages, bundled to wwwroot/js/main.js (with fingerprinted copies of the files a page loads).",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "lit-html": "^3.3.3",
    "mediabunny": "1.66.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
